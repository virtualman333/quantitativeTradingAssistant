{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true
  },
  // electron/ 用 tsconfig.electron.json 单独编译为 CommonJS（preload 必须是 CJS）
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "ui"]
}
