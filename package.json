{
  "name": "okx-trader-agent",
  "version": "0.1.0",
  "private": true,
  "description": "OKX 自主交易专用 Agent（TS 常驻进程，5 分钟自驱决策，不依赖聊天会话）",
  "type": "module",
  "main": "dist/electron/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.electron.json && tsc -p tsconfig.preload.json && node scripts/postbuild.mjs && vite build",
    "dev": "tsx src/main.ts",
    "start": "node dist/src/main.js",
    "once": "tsx src/main.ts --once",
    "dry": "tsx src/main.ts --once --dry-run",
    "ui": "npm run build && electron .",
    "ui:vite": "vite",
    "ui:dev": "node scripts/dev-ui.mjs",
    "dist": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.13",
    "@langchain/mcp-adapters": "^1.1.4",
    "@langchain/openai": "^1.5.11",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "markdown-it": "^15.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.21",
    "vue": "^3.5.42"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "com.local.okx-trader-agent",
    "productName": "OKX交易Agent",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "ui/**/*",
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts"
      },
      {
        "from": "AGENT_TRADING_RULES.md",
        "to": "AGENT_TRADING_RULES.md"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": ""
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
